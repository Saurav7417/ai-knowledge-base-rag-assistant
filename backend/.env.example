# Application Settings
PROJECT_NAME="AI Knowledge Base & Research Assistant"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: Local SQLite (Zero-setup local mode)
DATABASE_URL="sqlite:///./knowledge_base.db"
# Production PostgreSQL + pgvector example:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/knowledge_base_db"

# Embedding Provider Configuration
# Options: "openai" or "deterministic_mock"
EMBEDDING_PROVIDER="deterministic_mock"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# LLM Provider Configuration
# Options: "openai" or "mock"
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# RAG Hyperparameters
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.35
RERANKER_ENABLED=true

# Storage Settings
UPLOAD_DIR="./uploads"
